classDiagram
    %% Final design: matches pawpal_system.py

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet
        +get_all_tasks() list~tuple~Pet, Task~~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
        +complete_task(title: str) Task
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str time
        +str frequency
        +date due_date
        +bool completed
        +mark_complete() Task
        +priority_value() int
    }

    class Scheduler {
        +Owner owner
        +list~tuple~Pet, Task~~ plan
        +list~tuple~Pet, Task~~ skipped
        +sort_by_time(pairs) list
        +sort_by_priority(pairs) list
        +filter_tasks(pet_name, completed, on_date) list
        +filter_by_time(pairs) list
        +detect_conflicts(pairs) list~str~
        +mark_task_complete(pet_name: str, title: str) Task
        +generate_plan(on_date: date) list
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : needs
    Scheduler --> Owner : plans for
    Task ..> Task : mark_complete() creates next occurrence
